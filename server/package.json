{
  "name": "servercn-drizzle-pg-starter",
  "version": "1.0.0",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch src/server.ts",
    "build": "tsc",
    "start": "cross-env NODE_ENV=production node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "bun run src/drizzle/seed.ts",
    "db:studio": "drizzle-kit studio",
    "lint:check": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "bunx prettier . --check",
    "format:fix": "bunx prettier . --write",
    "docs": "tsx swagger.config.ts",
    "test": "bun test"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/source-map-support": "^0.5.10",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.0",
    "eslint-plugin-prettier": "^5.5.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "dotenv-flow": "^4.1.0",
    "drizzle-orm": "^0.45.4",
    "drizzle-seed": "^0.3.1",
    "drizzle-zod": "^0.8.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "slugify": "^1.6.9",
    "source-map-support": "^0.5.21",
    "swagger-autogen": "^2.23.7",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7",
    "morgan": "^1.12.1"
  },
  "engines": {
    "node": "24.x"
  }
}
